# ---------------------------------------------------------------------------
# AgentSwarm — what is tracked and what is not
#
# The research output is the point of this repo, so all of it is tracked:
#   arena/world/**        the artifacts the agents actually produced
#   arena/docs/**         the writeups
#   site/**               the published site (source + self-contained build)
#   arena/runs/*/turns.jsonl, summary.json, events.jsonl, incidents.jsonl
#                         the forensic ledgers (small, and the site reads them)
#
# What is NOT tracked is raw process exhaust: the per-turn stdout event streams
# are ~83 MB of one-JSON-object-per-line CLI output, they are already reduced to
# turns.jsonl by the engine, and they would make the repo painful to clone.
# ---------------------------------------------------------------------------

# --- raw substrate event streams (83 MB; already reduced into turns.jsonl) ---
arena/runs/**/*.stdout.jsonl
arena/runs/**/*.stderr.log

# --- transient capture files ---
arena/runs/*.txt
arena/runs/*-console.log
arena/STOP

# --- Python caches (agents ran pytest in world/) ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- generated build output ---
# Both site/dist and site/corpus are tracked so that deployments rooted at repo
# root, docs/, or site/ (such as Vercel) have all corpus pages available directly.
node_modules/
.pnpm-store/

# Windows reserved device names can appear in world/ when an agent redirects output
# to `nul` (an agent did this on 2026-10-03). Git cannot index such files, and one
# unaddable file blocks `git add -A` for the whole repository. The artifact stays on
# disk — it is simply untracked.
arena/world/nul
arena/world/con
arena/world/prn
arena/world/aux

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# --- secrets ---
.env
.env.*
!.env.example

# stray commit-message temp files
commitmsg.tmp
.commitmsg.tmp


# --- parallel Step runs (arena/parallel/<slug>/): same raw-exhaust policy as
# arena/runs — the per-turn *.stdout.jsonl streams are already reduced into
# turns.jsonl and are large (10+ MB/turn), so they are not tracked. ---
arena/parallel/**/*.stdout.jsonl
arena/parallel/**/*.stderr.log
