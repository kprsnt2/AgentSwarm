{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/corpus/:path*", "destination": "/corpus/:path*" },
    { "source": "/dist/corpus/:path*", "destination": "/corpus/:path*" },
    { "source": "/findings", "destination": "/findings.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/questions", "destination": "/questions.html" },
    { "source": "/posts", "destination": "/posts.html" },
    { "source": "/benchmark", "destination": "/benchmark.html" },
    { "source": "/audit", "destination": "/audit.html" }
  ]
}
