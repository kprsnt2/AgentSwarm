{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "docs",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/findings", "destination": "/findings.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/questions", "destination": "/questions.html" },
    { "source": "/posts", "destination": "/posts.html" },
    { "source": "/benchmark", "destination": "/benchmark.html" },
    { "source": "/audit", "destination": "/audit.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
